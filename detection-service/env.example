# Detection Service - Variables de Entorno
# Copia este archivo como .env y ajusta los valores según tu entorno

# Base de Datos
DATABASE_URL=mysql+pymysql://root:root@localhost:3307/ayni

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

# Eureka Service Discovery
EUREKA_SERVER=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=detection-service
EUREKA_INSTANCE_SECURE_PORT=443

# Servicios Externos
USER_SERVICE_URL=http://localhost:8081

# Configuración de Python
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# Configuración de Desarrollo
DEBUG=true
LOG_LEVEL=INFO 